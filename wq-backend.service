[Unit]
Description=WQ membership backend
After=network.target
[Service]
User=wqbackend
Group=wqbackend
WorkingDirectory=/opt/wq-backend
EnvironmentFile=/etc/wq-backend.env
ExecStartPre=/opt/wq-backend/.venv/bin/python -c "import app"
ExecStart=/opt/wq-backend/.venv/bin/gunicorn --workers 2 --bind 0.0.0.0:8000 --timeout 30 --error-logfile - app:app
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/wq-backend
[Install]
WantedBy=multi-user.target
